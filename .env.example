# Example environment configuration for ai-gateway.
#
# Copy this file to `.env` (or source it in your shell) before starting
# the server. Only `ENV` is strictly required.

# ---- Required ---------------------------------------------------------------

# Run mode. Use "local" for development, anything else for production.
ENV=local

# ---- Logging / server -------------------------------------------------------

LOG_LEVEL=INFO

# ---- Models -----------------------------------------------------------------

# JSON catalog of model configs. Required - the server has no models
# available until this is set. Defaults to a local Ollama instance
# (`ollama pull qwen2.5:14b`); edit or replace to point at a different
# OpenAI-compatible endpoint (e.g. LM Studio on http://localhost:1234/v1),
# vLLM, Bedrock, etc.
#
# JSON values MUST be single-quoted here: the Quickstart loads this file with
# `set -a && source .env && set +a`, and bash strips *unquoted* double quotes
# during sourcing, which would otherwise turn this into invalid JSON.
#
# The server itself runs inside Docker (see the Quickstart), so `address`
# must point at `host.docker.internal`, not `localhost`, to reach a backend
# running on your host machine (Ollama, LM Studio, etc.) - `localhost` inside
# the container refers to the container itself. Use `localhost` only if
# running via ./scripts/start-local-native.sh (no Docker).
#
# `category` (must be "chat" or "summary"), `maker`, `friendly_name`, and
# `description` are also required for the model to show up in `/v1/models`.
MODELS='{"qwen-14b-instruct":{"backend":"litellm","type":"llm","upstream_model":"qwen2.5:14b","address":"http://host.docker.internal:11434/v1","free":true,"max_tokens":4096,"conversation_token_limit":8192,"rate_limit":0,"rate_limit_interval_seconds":0,"category":"chat","maker":"Alibaba","friendly_name":"Qwen 2.5 14B Instruct","description":{"en":"Local Qwen 2.5 14B model served via Ollama."}}}'

# JSON triage table mapping categories to {non-premium, premium} model picks;
# also required for `automatic` model routing and for conversation titling
# (needs a "conversation_title" key) - see "Configuring models" in README.md.
# MODEL_TRIAGING='{}'

# ---- Conversation features --------------------------------------------------

CONVERSATION_API=1
CONVERSATION_TITLE_ENABLED=0
SEARCH_ENABLED=0
FUNCTION_CALLING_ENABLED=0
USE_VLLM_CHAT_API=1
# Currently unused - conversation-title requests are routed via
# MODEL_TRIAGING's "conversation_title" key instead. Left here for parity
# with other model-selection variables.
TITLE_MODEL=qwen-14b-instruct
ALLOWED_LANGUAGES='["en","fr","de","it","es"]'

# ---- Optional: internal model passthrough API key --------------------------

# When set, embeddings / TTS / STT / System One / image generation require:
#   Authorization: Bearer <INTERNAL_MODELS_API_KEY>
# Leave unset for local dev (no gate). Use one shared team secret in deploys.
# INTERNAL_MODELS_API_KEY=

# ---- Optional: upstream API keys -------------------------------------------

# Only needed if you configure those backends.
# NEAR_API_KEY=
# BRAVE_SEARCH_API_KEY=
# BRAVE_SEARCH_RH_API_KEY=
# VLLM_API_KEY=
# HF_TOKEN=

# ---- Optional: Redis (only used when rate limiting is enabled) -------------

# REDIS_HOST=localhost
# REDIS_PASSWORD=
# RATE_LIMITING_ENABLED=0
